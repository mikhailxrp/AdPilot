# Скопируй в .env и подставь свои значения (.env в Git не попадает)

# PostgreSQL (docker compose, сервис db)
POSTGRES_USER=adpilot
POSTGRES_PASSWORD=change-me
POSTGRES_DB=adpilot

# С хоста Postgres доступен на порту 5434; внутри сети Compose — db:5432
DATABASE_URL="postgresql://adpilot:change-me@localhost:5434/adpilot"

# Auth.js — сгенерировать: npx auth secret
AUTH_SECRET="change-me"

# Админ для seed (таск 3)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me"

# Auth.js за Docker/reverse proxy: доверять заголовку Host (без этого вне dev — UntrustedHost, 500)
AUTH_TRUST_HOST=true

# Публичный адрес приложения в Docker (редиректы Auth.js). На VPS — свой домен
AUTH_URL=http://localhost:3000

# Bearer-токен мока Директа (app/api/mock/direct). Сгенерировать:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MOCK_API_TOKEN="change-me"

# Адрес мока Директа для MockProvider (агент, worker): корень мока, путь /json/v5/... добавляется сам
MOCK_API_URL="http://localhost:3000/api/mock/direct"
# В Docker Compose worker получает MOCK_API_URL=http://web:3000/api/mock/direct из docker-compose.yml

# LLM-движок (Phase 3): yandex — Yandex AI Studio, fake — без сети и ключей (тесты, e2e)
LLM_CLIENT=yandex
# API-ключ сервисного аккаунта (scope yc.ai.languageModels.execute) и ID каталога
YANDEX_API_KEY="change-me"
YANDEX_FOLDER_ID="change-me"
# URI модели; пусто — gpt://<YANDEX_FOLDER_ID>/aliceai-llm/latest
LLM_MODEL_URI=""

# --- Прод (VPS) ---
# Запуск на сервере (явные -f отключают docker-compose.override.yml, порты web и db наружу не публикуются):
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d --build
# Публичный адрес с https:// — обязателен в prod, без него compose не стартует.
# Для VPS замени значение AUTH_URL выше на свой домен, например:
#   AUTH_URL=https://adpilot.example.com
# В prod также замени все change-me (POSTGRES_PASSWORD, AUTH_SECRET, ADMIN_PASSWORD, MOCK_API_TOKEN).
# Перед миграциями prod-стек проверяет .env (scripts/check-env.ts) и не стартует, если: любой из этих четырёх секретов пуст
# или равен change-me, AUTH_SECRET короче 32 символов, AUTH_URL не начинается с https://,
# DOMAIN пуст или не имя хоста (со схемой, портом, путём). В dev проверки нет.
#
# Traefik и домен (prod). Все значения нужны Compose для labels и сети; без DOMAIN, TRAEFIK_NETWORK и TRAEFIK_ENTRYPOINT он не стартует.
# DOMAIN — домен панели без https://; A-запись домена должна смотреть на сервер. AUTH_URL выше — тот же домен с https://.
DOMAIN=adpilot.example.com
# Внешняя docker-сеть, в которой работает Traefik: `docker network ls` на сервере или networks в compose-файле Traefik
TRAEFIK_NETWORK=traefik
# Entrypoint HTTPS-трафика: --entrypoints.<имя>.address=:443 в конфиге Traefik, обычно websecure
TRAEFIK_ENTRYPOINT=websecure
# Имя certificatesresolvers.<имя> из конфига Traefik (Let's Encrypt), например letsencrypt
TRAEFIK_CERTRESOLVER=letsencrypt
# Локальная проверка prod-стека за docker-compose.traefik-local.yml: DOMAIN=localhost, AUTH_URL=https://localhost,
# TRAEFIK_NETWORK=traefik, TRAEFIK_ENTRYPOINT=websecure, TRAEFIK_CERTRESOLVER= (пусто — самоподписанный сертификат)

# Бэкап БД (prod, сервис backup в docker-compose.prod.yml): pg_dump -Fc в ./backups на хосте, cron не нужен.
# Интервал между дампами в секундах (86400 = сутки) и сколько дней хранить; самый свежий дамп не удаляется никогда.
# В дампе хеш пароля админа и данные журнала: папка ./backups — только для администратора сервера, в Git и в образ не попадает.
BACKUP_INTERVAL_SEC=86400
BACKUP_KEEP_DAYS=14
