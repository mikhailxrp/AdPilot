generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("users")
}

enum RunStatus {
  ACTIVE
  ARCHIVED

  @@map("run_status")
}

enum CampaignState {
  ON
  SUSPENDED

  @@map("campaign_state")
}

model SimulationRun {
  id          String     @id @default(cuid())
  seed        Int
  currentTick Int        @default(0) @map("current_tick")
  status      RunStatus  @default(ACTIVE)
  campaigns   Campaign[]
  decisions   Decision[]
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  @@map("simulation_runs")
}

model Campaign {
  id          String         @id @default(cuid())
  runId       String         @map("run_id")
  run         SimulationRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  name        String
  state       CampaignState  @default(ON)
  bid         Int
  dailyBudget Int            @map("daily_budget")
  targetCpo   Int            @map("target_cpo")
  truth       CampaignTruth?
  tickStats   TickStats[]
  decisions   Decision[]
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  @@index([runId])
  @@map("campaigns")
}

model CampaignTruth {
  id              String   @id @default(cuid())
  campaignId      String   @unique @map("campaign_id")
  campaign        Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  ctr             Float
  cr              Float
  bidSensitivity  Float    @map("bid_sensitivity")
  baseImpressions Int      @map("base_impressions")
  referenceBid    Int      @map("reference_bid")
  degradeFromTick Int?     @map("degrade_from_tick")
  degradedCr      Float?   @map("degraded_cr")

  @@map("campaign_truths")
}

model TickStats {
  id          String   @id @default(cuid())
  campaignId  String   @map("campaign_id")
  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  tick        Int
  impressions Int
  clicks      Int
  orders      Int
  cost        Int
  bid         Int
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([campaignId, tick])
  @@map("tick_stats")
}

enum AgentEngine {
  RULES
  LLM

  @@map("agent_engine")
}

enum DecisionAction {
  WAIT_DATA
  HOLD
  LOWER_BID
  RAISE_BID
  RAISE_BUDGET
  PAUSE

  @@map("decision_action")
}

enum DecisionVerdict {
  ACCEPTED
  REJECTED

  @@map("decision_verdict")
}

// Дефолты порогов — в lib/validations/agent-config.ts (единственный источник)
model AgentConfig {
  id              String      @id
  engine          AgentEngine
  dryRun          Boolean     @map("dry_run")
  timerEnabled    Boolean     @map("timer_enabled")
  tickIntervalSec Int         @map("tick_interval_sec")
  minClicks       Int         @map("min_clicks")
  maxStepPct      Int         @map("max_step_pct")
  maxDailyBudget  Int         @map("max_daily_budget")
  cooldownTicks   Int         @map("cooldown_ticks")
  cpoTolerancePct Int         @map("cpo_tolerance_pct")
  windowTicks     Int         @map("window_ticks")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  @@map("agent_configs")
}

model Decision {
  id           String          @id @default(cuid())
  runId        String          @map("run_id")
  run          SimulationRun   @relation(fields: [runId], references: [id], onDelete: Restrict)
  campaignId   String          @map("campaign_id")
  campaign     Campaign        @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  tick         Int
  engine       AgentEngine
  action       DecisionAction
  before       Int?
  after        Int?
  reason       String
  metrics      Json
  dryRun       Boolean         @map("dry_run")
  verdict      DecisionVerdict
  rejectReason String?         @map("reject_reason")
  rawResponse  String?         @map("raw_response")
  applyError   String?         @map("apply_error")
  shadowAction DecisionAction? @map("shadow_action")
  shadowAfter  Int?            @map("shadow_after")
  shadowReason String?         @map("shadow_reason")
  createdAt    DateTime        @default(now()) @map("created_at")

  @@index([runId, tick])
  @@index([campaignId])
  @@map("decisions")
}
